{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi"
    },
    "admin": {
      "root": "apps/admin",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "defi-orchestrator-py",
          "format": "url",
          "env": "DEFI_ORCHESTRATOR_URL"
        }
      ]
    },
    "defi-orchestrator-py": {
      "root": "defi-orchestrator-py",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "defi-orchestrator-py"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
